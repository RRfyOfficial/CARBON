# CARBON · iMac-only settings for deploy.sh
# Copy to ios/.env.local ON THE iMAC and fill in. .env.local is gitignored. Never commit it.

# Russell's iPhone UDID.
# Find it with: xcrun xctrace list devices
# It's the long ID in the last parentheses on the iPhone's line.
CARBON_UDID=""

# Must match the Xcode project's bundle identifier.
CARBON_BUNDLE_ID="com.example.Carbon"
